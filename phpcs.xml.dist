<?xml version="1.0"?>
<ruleset name="MoodleX Hub">
    <description>Moodle coding standard for the plugin.</description>
    <file>.</file>
    <exclude-pattern>*/artifacts/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tools/lab/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <rule ref="moodle"/>
</ruleset>
