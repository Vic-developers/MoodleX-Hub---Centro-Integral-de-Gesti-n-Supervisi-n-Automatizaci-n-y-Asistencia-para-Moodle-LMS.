{{!
    @template local_moodlexhub/report_table

    Example context (json):
    {
        "title": "Course categories",
        "hasrows": true,
        "headings": ["Name", "Courses"],
        "rows": [{"cells":["Physics", "5"]}]
    }
}}
{{#hasrows}}
    <div class="table-responsive">
        <table class="table">
            <caption>{{title}}</caption>
            <thead><tr>{{#headings}}<th scope="col">{{.}}</th>{{/headings}}</tr></thead>
            <tbody>{{#rows}}<tr>{{#cells}}<td>{{.}}</td>{{/cells}}</tr>{{/rows}}</tbody>
        </table>
    </div>
{{/hasrows}}
{{^hasrows}}<p>{{title}} · {{#str}} reportnodata, local_moodlexhub {{/str}}</p>{{/hasrows}}
